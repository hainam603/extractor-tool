{
  "name": "extractor-tool",
  "version": "1.0.0",
  "description": "Tool to extract working experience from DOCX/PDF to Excel",
  "main": "server.js",
  "bin": "server.js",
  "pkg": {
    "assets": [
      "public/**/*"
    ],
    "targets": [
      "node18-win-x64"
    ]
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build": "pkg . --output extractor-tool.exe"
  },
  "dependencies": {
    "adm-zip": "^0.5.12",
    "exceljs": "^4.4.0",
    "express": "^4.21.0",
    "fast-xml-parser": "^4.4.1",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^1.1.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  }
}
